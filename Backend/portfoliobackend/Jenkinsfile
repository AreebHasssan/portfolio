pipeline {
    agent any

    environment {
        DOCKER_IMAGE     = "areebhassan/portfolio-backend"
        IMAGE_TAG        = "${BUILD_NUMBER}"
        DOCKER_HUB_CREDS = "dockerhub-credentials-id"
        KUBECONFIG_CREDS = "k8s-kubeconfig-id"
        EMAIL            = "areebhs025@gmail.com"
        NODE_PORT        = "30080"
        CONTAINER_NAME   = "nodejs" // Old standalone container name
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/farzeen-ali/CI-CD-Pipeline-Using-Jenkins-GitHub-Webhook-Ubuntu-AWS-EC2-Docker.git'
            }
        }

        stage('Stop & Remove Old Standalone Containers') {
            steps {
                // Kills the old standalone docker container if it exists
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm -f ${CONTAINER_NAME} || true
                """
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                    docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} -t ${DOCKER_IMAGE}:latest .
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${DOCKER_HUB_CREDS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: "${KUBECONFIG_CREDS}", variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl apply -f k8s/deployment.yaml
                        kubectl set image deployment/portfolio-backend portfolio-backend=${DOCKER_IMAGE}:${IMAGE_TAG}
                        kubectl rollout status deployment/portfolio-backend --timeout=120s
                    """
                }
            }
        }
    }

    post {
        always {
            // Clean up old and unused images from the host to free disk space
            sh """
                docker image prune -af --filter "until=24h" || true
                docker logout || true
            """
        }
        success {
            emailext(
                subject: "Portfolio Backend Deployed Successfully! (Build #${BUILD_NUMBER})",
                body: "Your portfolio backend has been deployed. Old containers have been cleared.\nAccess: http://<EC2_OR_NODE_IP>:${NODE_PORT}/",
                to: "${EMAIL}"
            )
        }
        failure {
            emailext(
                subject: "Deployment Failed: Build #${BUILD_NUMBER}",
                body: "Deployment failed. Review console output for details.",
                to: "${EMAIL}"
            )
        }
    }
}